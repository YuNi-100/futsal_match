# Copy to .env.supabase privately. This file alone does NOT switch the running app.
# Get exact host/user from Supabase Connect > Session pooler (port 5432).
# URL-encode reserved password characters. Never paste credentials into chat.
WGH_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@EXACT_POOLER_HOST:5432/postgres?sslmode=require
