# Copy the NAMES needed into the existing .env; do not overwrite existing values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Production: register https://YOUR_DOMAIN/auth/google/callback in Google Cloud.
# HTTPS callback automatically enables Secure and __Host- session cookies.

# Keep mysql until Supabase migration and verification are complete.
DB_ENGINE=mysql
# For Supabase use Session pooler port 5432 or a direct connection, with sslmode=require.
# Never expose this database password/URL in browser code.
DATABASE_URL=
POSTGRES_EXPECTED_DATABASE=postgres
WGH_ALLOW_ANALYSIS_WRITES=false
WGH_ALLOW_SYNC_WRITES=false
